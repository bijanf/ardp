title: "ARDP: AMOC Reanalysis Diagnostic Pipeline"
type: software
authors:
  - family-names: Fallah
    given-names: Bijan
  - family-names: Rostami
    given-names: Masoud
  - family-names: Guo
    given-names: Junxin
